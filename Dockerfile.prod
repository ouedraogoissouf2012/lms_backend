FROM php:8.3-apache-bookworm

# --- Dependances systeme -----------------------------------------------------
# libreoffice-{impress,writer} + ghostscript + imagick : la chaine de conversion
# PPT/DOCX/PDF -> diapositives PNG. Le code tente ConvertAPI en premier puis
# retombe sur LibreOffice ; sans ces binaires le fallback echoue et tout
# televersement de presentation est perdu.
# On installe les paquets LibreOffice *cibles* (pas le meta-paquet complet) :
# ~700 Mo au lieu de ~1,5 Go.
RUN apt-get update && apt-get install -y --no-install-recommends \
        git unzip curl \
        libzip-dev libpng-dev libonig-dev libxml2-dev libmagickwand-dev \
        libreoffice-impress libreoffice-writer libreoffice-core \
        default-jre-headless fonts-liberation \
        ghostscript \
    && docker-php-ext-install -j$(nproc) pdo_mysql mbstring zip gd bcmath opcache \
    && pecl install imagick \
    && docker-php-ext-enable imagick \
    && a2enmod rewrite headers \
    && rm -rf /var/lib/apt/lists/*
# Note : on ne purge PAS libmagickwand-dev. Un `apt-get purge --auto-remove`
# emporte avec lui la bibliotheque d'execution libMagickWand-6.Q16.so.6, dont
# l'extension imagick a besoin au runtime — l'extension compile mais refuse
# ensuite de se charger, et PHP emet un avertissement a chaque invocation.
# Le paquet -dev pese quelques dizaines de Mo sur une image de ~1,9 Go :
# le gain ne justifie pas de casser le rendu PDF.

# Garde de build : la chaine de conversion doit etre operationnelle DANS l'image.
# Sans ce controle, une extension qui compile mais ne se charge pas (bibliotheque
# d'execution absente) passe inapercue jusqu'a la production, ou elle se signale
# par un avertissement PHP sur chaque commande. Mieux vaut casser le build.
RUN php -m | grep -qx imagick || (echo "ECHEC: extension imagick non chargee" && php -m && exit 1) \
    && command -v soffice >/dev/null || (echo "ECHEC: libreoffice absent" && exit 1) \
    && command -v gs >/dev/null || (echo "ECHEC: ghostscript absent" && exit 1)

# ImageMagick interdit la lecture des PDF par defaut depuis CVE-2016-3714.
# PdfToPngRenderer en depend : sans cette autorisation, le rendu des diapositives
# echoue avec « not authorized ». On n'ouvre QUE le PDF, pas les autres coders.
RUN if [ -f /etc/ImageMagick-6/policy.xml ]; then \
        sed -i 's|<policy domain="coder" rights="none" pattern="PDF" />|<policy domain="coder" rights="read" pattern="PDF" />|' /etc/ImageMagick-6/policy.xml; \
    fi

COPY --from=composer:2 /usr/bin/composer /usr/bin/composer

WORKDIR /var/www/html

COPY docker/apache-vhost.conf /etc/apache2/sites-available/000-default.conf
COPY docker/uploads.ini /usr/local/etc/php/conf.d/uploads.ini
COPY docker/opcache.ini /usr/local/etc/php/conf.d/opcache.ini

# Couche de dependances separee du code : un changement applicatif ne reinstalle
# pas tout Composer (build plus court, moins de RAM — le serveur heberge d'autres
# projets et un build gourmand peut le faire tomber).
COPY composer.json composer.lock ./
RUN composer install --no-dev --no-interaction --prefer-dist \
        --optimize-autoloader --no-scripts --no-autoloader

COPY . .
RUN composer dump-autoload --optimize --no-dev \
    && chown -R www-data:www-data storage bootstrap/cache \
    && chmod -R ug+rwx storage bootstrap/cache

COPY docker/entrypoint.sh /usr/local/bin/entrypoint.sh
RUN chmod +x /usr/local/bin/entrypoint.sh

EXPOSE 80

# Pas de HEALTHCHECK ici : cette image sert les trois roles (web, worker,
# scheduler) et seul le role web ecoute en HTTP. Un healthcheck /up global
# marquerait worker et scheduler « unhealthy » en permanence, avec redemarrage
# en boucle sous Swarm. Le healthcheck est donc declare par service dans
# docker-compose.prod.yml.

ENTRYPOINT ["entrypoint.sh"]
