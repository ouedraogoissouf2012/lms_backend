/diagnostics/
# .claude/ : keep workflow files, ignore local/specs
/.claude/settings.local.json
/.claude/specs/
/.claude/steering/
/.claude/cache/
postman_collection.json
issue_*.md
screenshot_*.png

# Tous les tests sont versionnes. Ne jamais reintroduire une exclusion globale
# de /tests : elle rend les preuves locales invisibles pour la CI (#458).
.env.example
.env.production.example
package.json
vite.config.js
.editorconfig
.gitattributes
