# Issue #367 — worker de queue Laravel supervise en continu.
#
# Contrairement au cPanel mutualise (docs/DEPLOYMENT_OPS.md §3, qui doit
# "voler" 55 secondes de cron chaque minute faute de demon possible), le
# VPS autorise un vrai processus resident : c'est la contrainte que #367
# leve en premier (critere d'acceptation : "un process php artisan
# queue:work peut tourner en continu").
#
# Ceci est un TEMPLATE (meme convention que 03-nginx-lms-backend.conf.template) :
# ${DEPLOY_USER} et ${APP_DIR} doivent etre substitues avant installation —
# ne jamais faire un `cp` direct, sinon le service reste fige sur les valeurs
# par defaut de 01/02-install-stack.sh meme si l'operateur les a personnalisees.
#
# Installation :
#   export DEPLOY_USER=deploy APP_DIR=/var/www/lms-backend
#   envsubst '${DEPLOY_USER} ${APP_DIR}' \
#     < scripts/vps/lms-queue-worker.service \
#     | sudo tee /etc/systemd/system/lms-queue-worker.service
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now lms-queue-worker
#
# --max-time=3600 + Restart=always : le worker se relance tout seul toutes
# les heures (recommandation Laravel officielle contre les fuites memoire
# des processus PHP long-running), sans jamais laisser la queue sans
# consommateur plus de quelques secondes (RestartSec=5).

[Unit]
Description=LMS Backend - Laravel queue worker
After=network.target mysql.service redis-server.service

[Service]
User=${DEPLOY_USER}
Group=${DEPLOY_USER}
WorkingDirectory=${APP_DIR}
ExecStart=/usr/bin/php ${APP_DIR}/artisan queue:work --sleep=3 --tries=3 --max-time=3600 --timeout=120
Restart=always
RestartSec=5

# Duree max avant SIGKILL si le worker ne s'arrete pas proprement seul
# (--max-time gere l'arret normal ; ceci est le filet de securite).
TimeoutStopSec=30

[Install]
WantedBy=multi-user.target
