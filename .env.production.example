# ===================================
# CONFIGURATION PRODUCTION - cPanel
# ===================================
# À copier dans .env sur le serveur
# Remplacer les valeurs entre <> par les vraies valeurs

APP_NAME="LMS KLASSCI Backend"
APP_ENV=production
APP_KEY=<GENERER_AVEC: php artisan key:generate>
APP_DEBUG=false
APP_URL=https://votre-domaine.com

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

# Base de données (SQLite ou MySQL selon cPanel)
DB_CONNECTION=sqlite
# OU pour MySQL:
# DB_CONNECTION=mysql
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=<nom_base_donnees>
# DB_USERNAME=<utilisateur_bdd>
# DB_PASSWORD=<mot_de_passe_bdd>

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=file
CACHE_DRIVER=file

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Configuration email (à configurer selon cPanel)
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=<serveur_smtp_cpanel>
MAIL_PORT=587
MAIL_USERNAME=<email@domaine.com>
MAIL_PASSWORD=<mot_de_passe_email>
MAIL_FROM_ADDRESS=<email@domaine.com>
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# ============================================
# KLASSCI API CONFIGURATION - MULTI-TENANT
# ============================================

# Instance par défaut
KLASSCI_API_URL=http://presentation.klassci.com/api/lms
KLASSCI_API_TOKEN=<VOTRE_TOKEN_KLASSCI>
KLASSCI_CACHE_TTL=300
KLASSCI_TIMEOUT=30

# INSTANCE 1: Présentation (Démo)
KLASSCI_PRESENTATION_URL=http://presentation.klassci.com/api/lms
KLASSCI_PRESENTATION_TOKEN=<VOTRE_TOKEN>
KLASSCI_PRESENTATION_NAME="KLASSCI Présentation"

# INSTANCE 2: ESBTP Abidjan
KLASSCI_ESBTP_ABIDJAN_URL=https://esbtp-abidjan.klassci.com/api/lms
KLASSCI_ESBTP_ABIDJAN_TOKEN=<VOTRE_TOKEN>
KLASSCI_ESBTP_ABIDJAN_NAME="ESBTP Abidjan"

# INSTANCE 3: ESBTP Yakro
KLASSCI_ESBTP_YAKRO_URL=https://esbtp-yakro.klassci.com/api/lms
KLASSCI_ESBTP_YAKRO_TOKEN=<VOTRE_TOKEN>
KLASSCI_ESBTP_YAKRO_NAME="ESBTP Yakro"
