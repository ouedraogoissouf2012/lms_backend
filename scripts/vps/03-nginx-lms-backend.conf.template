# Issue #367 — template de vhost Nginx pour le backend LMS sur VPS.
#
# Ne pas copier tel quel : remplacer __DOMAIN__ et __APP_DIR__ puis deposer
# dans /etc/nginx/sites-available/, par exemple :
#
#   export DOMAIN=api.klassci.com APP_DIR=/var/www/lms-backend
#   envsubst '${DOMAIN} ${APP_DIR}' \
#     < scripts/vps/03-nginx-lms-backend.conf.template \
#     | sudo tee /etc/nginx/sites-available/lms-backend.conf
#   sudo ln -s /etc/nginx/sites-available/lms-backend.conf /etc/nginx/sites-enabled/
#   sudo rm -f /etc/nginx/sites-enabled/default
#   sudo nginx -t && sudo systemctl reload nginx
#
# Le certificat TLS n'est PAS configure ici : 04-setup-tls.sh (certbot
# --nginx) reecrit ce fichier pour ajouter le bloc 443 + redirection HTTPS.
# Ce template ne sert donc que de bootstrap HTTP le temps d'obtenir le
# certificat (validation HTTP-01 de Let's Encrypt).

server {
    listen 80;
    listen [::]:80;
    server_name ${DOMAIN};

    root ${APP_DIR}/public;
    index index.php;

    charset utf-8;

    # En-tetes de securite de base (defense-in-depth, cf. semgrep p/owasp-top-ten en CI)
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "DENY" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;

    client_max_body_size 100M;

    location / {
        try_files $uri $uri/ /index.php?$query_string;
    }

    location ~ \.php$ {
        fastcgi_pass unix:/run/php/php8.3-fpm.sock;
        fastcgi_index index.php;
        include fastcgi_params;
        fastcgi_param SCRIPT_FILENAME $realpath_root$fastcgi_script_name;
        fastcgi_hide_header X-Powered-By;
    }

    # Jamais servir .env, .git ou les fichiers caches. NB : "storage" est
    # volontairement absent de cette liste : root pointe sur ${APP_DIR}/public,
    # donc la seule chose que "/storage" peut resoudre ici est le symlink
    # public genere par `php artisan storage:link` (storage/app/public) —
    # utilise en production pour servir les fichiers uploades (ex.
    # ChapterFileUploadService). Le storage/ interne de Laravel (hors public/)
    # n'est de toute facon pas atteignable via ce root, deny all ou pas.
    location ~ /\. {
        deny all;
    }
    location ~ ^/(\.env|bootstrap/cache) {
        deny all;
    }

    access_log /var/log/nginx/lms-backend.access.log;
    error_log  /var/log/nginx/lms-backend.error.log;
}
