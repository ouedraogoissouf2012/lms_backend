<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         beStrictAboutOutputDuringTests="true"
         beStrictAboutTestsThatDoNotTestAnything="true"
         colors="true"
         displayDetailsOnIncompleteTests="true"
         displayDetailsOnSkippedTests="true"
         displayDetailsOnTestsThatTriggerDeprecations="true"
         displayDetailsOnTestsThatTriggerErrors="true"
         displayDetailsOnTestsThatTriggerNotices="true"
         displayDetailsOnTestsThatTriggerWarnings="true"
         failOnDeprecation="true"
         failOnNotice="true"
         failOnRisky="true"
         failOnWarning="true">
    <testsuites>
        <testsuite name="Unit">
            <directory>tests/Unit</directory>
            <!-- Tests temporairement exclus — dette technique à fixer dans une issue dédiée. -->
            <exclude>tests/Unit/TokenEncryptionTest.php</exclude>
            <exclude>tests/Unit/ExceptionHandlerTest.php</exclude>
        </testsuite>
        <testsuite name="Feature">
            <directory>tests/Feature</directory>
            <!-- Tests temporairement exclus — restants (batches TEST-01 suivants). -->
            <exclude>tests/Feature/ResolveInstitutionMiddlewareTest.php</exclude>
            <exclude>tests/Feature/AdminAnalyticsCacheIsolationTest.php</exclude>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory>app</directory>
        </include>
    </source>
    <php>
        <ini name="display_errors" value="1"/>
        <ini name="error_reporting" value="-1"/>
        <!-- Suite complète bootstrappe ~150 MB de container Laravel + fixtures.
             128 MB par défaut PHP fait OOM avec dump de stack massif. -->
        <ini name="memory_limit" value="512M"/>
        <ini name="xdebug.mode" value="coverage"/>
        <env name="APP_ENV" value="testing"/>
        <!-- APP_KEY n'est PAS hardcodé ici (anti-pattern). Laravel le lit depuis
             le .env local du dev. CI doit fournir APP_KEY via env var GitHub Actions
             si PHPUnit est ajouté au workflow. -->
        <env name="BCRYPT_ROUNDS" value="4"/>
        <env name="CACHE_DRIVER" value="array"/>
        <env name="DB_CONNECTION" value="sqlite"/>
        <env name="DB_DATABASE" value="database/database.testing.sqlite"/>
        <env name="MAIL_DRIVER" value="array"/>
        <env name="QUEUE_CONNECTION" value="sync"/>
        <env name="SESSION_DRIVER" value="array"/>
        <env name="TELESCOPE_ENABLED" value="false"/>
    </php>
</phpunit>
