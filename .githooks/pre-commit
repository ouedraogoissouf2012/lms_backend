#!/bin/sh
# #702 — gardes rapides. Pas de PHPUnit ici : trop lent, le hook serait contourné.
set -e

files=$(git diff --cached --name-only --diff-filter=ACMR -- app || true)

if [ -n "$files" ]; then
    echo "$files" | tr '\n' '\0' | xargs -0 php scripts/check-file-sizes.php
    echo "$files" | tr '\n' '\0' | xargs -0 php scripts/check-method-sizes.php
fi

if git diff --cached -U0 | grep -E '^\+.*(JWT_APP_SECRET|APP_KEY)\s*=' | grep -viE 'fake|dummy|secret-de-test|openssl rand' >/dev/null 2>&1; then
    echo "pre-commit: possible secret en dur (JWT_APP_SECRET / APP_KEY)."
    echo "Utilise env()/config() ou une valeur explicitement fictive."
    exit 1
fi

exit 0
